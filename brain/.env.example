# Copy to the repository root as `.env` (gitignored) and fill in. Bun loads it automatically.
# Any OpenAI-compatible endpoint works. Examples:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://127.0.0.1:11434/v1   (no key needed)
MINE_AI_LLM_BASE_URL=
MINE_AI_LLM_API_KEY=
# Set to false if the provider rejects response_format json_object.
MINE_AI_LLM_JSON_MODE=true
MINE_AI_LLM_TIMEOUT_MS=30000

########### V2
MINE_AI_LLM_BASE_URL=...        # shared default
MINE_AI_LLM_API_KEY=...
MINE_AI_LLM_MODEL=...           # fallback for all tiers
MINE_AI_LLM_CHAT_MODEL=...      # optional, per tier
MINE_AI_LLM_ACTION_MODEL=...
MINE_AI_LLM_PLANNER_MODEL=...
# optional per-tier endpoint: MINE_AI_LLM_<CHAT|ACTION|PLANNER>_BASE_URL / _API_KEY