+        await settled(bot._takeCraftingResult(remaining, resultUpdates))
+        await settled(bot.putSelectedItemRange(window.inventoryStart, window.inventoryEnd, window, null))
         for (const { slot, item } of remaining) {
-          if (item) await bot.putAway(slot)
+          if (item) await settled(bot.putAway(slot))
         }
       }
 
