@@ -128,12 +154,41 @@ function inject (bot) {
       async function putMaterialsAway () {
         const start = window.inventoryStart
         const end = window.inventoryEnd
-        await bot.putSelectedItemRange(start, end, window, originalSourceSlot)
+        await settled(bot.putSelectedItemRange(start, end, window, originalSourceSlot))
         await grabResult()
       }
 
+      // A server may answer a grid click with a slot 0 update that is not yet the recipe's result (Paper: an empty
+      // one first, the result a few ms after the next click), and clickWindow returns on that first update. Wait for
+      // the result itself before taking it, bounded; past the bound the assert below says what it always said.
+      // With the round trip of settled() the result is already there on Paper (measured: inside the burst); this wait
+      // is what remains when the round trip is off, and for a result sent in a later tick (not measured).
+      function waitForRecipeResult () {
+        const holdsRecipeResult = () => {
+          const item = window.slots[0]
+          return !!item && item.type === recipe.result.id && item.count === recipe.result.count
+        }
+        if (holdsRecipeResult()) return Promise.resolve()
+        return new Promise(resolve => {
+          const finish = () => {
+            clearTimeout(timer)
+            window.removeListener('updateSlot:0', onSlotZero)
+            bot.removeListener('windowClose', onClose)
+            bot._client.removeListener('end', finish)
+            resolve()
+          }
+          const onSlotZero = () => { if (holdsRecipeResult()) finish() }
+          const onClose = closed => { if (closed === window) finish() }
+          const timer = setTimeout(finish, CRAFTING_RESULT_TIMEOUT)
+          window.on('updateSlot:0', onSlotZero)
+          bot.on('windowClose', onClose)
+          bot._client.on('end', finish)
+        })
+      }
+
       async function grabResult () {
         assert.strictEqual(window.selectedItem, null)
+        await waitForRecipeResult()
         const result = window.slots[0]
         assert.ok(result && result.type === recipe.result.id && result.count === recipe.result.count,
           'Server did not supply the expected crafting result')
