+    if (!serverAnswersRoundTrips) return result
+    try {
+      await bot.tabComplete('/', false, false, ROUND_TRIP_TIMEOUT)
+    } catch (err) {
+      serverAnswersRoundTrips = false
+    }
+    return result
+  }
