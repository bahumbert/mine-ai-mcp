 module.exports = inject
 
+// ms to wait for the result slot to hold the recipe's result; the same bound as inventory.js WINDOW_TIMEOUT
+const CRAFTING_RESULT_TIMEOUT = 5000
+// ms to wait for the server's answer to a tab_complete sent after a click (measured on Paper and vanilla: 1-10 ms)
+const ROUND_TRIP_TIMEOUT = 2000
+
 function inject (bot) {
   const Item = require('prismarine-item')(bot.registry)
   const Recipe = require('prismarine-recipe')(bot.registry).Recipe
   let windowCraftingTable
 
+  // One click can be answered by several packets, each with a new stateId (Paper: nine within 3 ms after one
+  // click). The next click is written with the last stateId received (inventory.js window_click); a server that is
+  // already further along ignores it and resyncs, which leaves the client's model wrong (a craft that "put away" its
+  // result while the server kept it on the cursor). The server handles packets in order and a tab_complete reply
+  // (as chat.js uses it) comes after every packet sent before it, so once it arrives the answers to our last click
+  // have arrived too. A server that does not answer it (or a bot without chat) costs ROUND_TRIP_TIMEOUT once: the
+  // rest of this craft call goes without the round trip, as clicks always did, and only the wait for the result
+  // slot (waitForRecipeResult) protects the take.
+  let serverAnswersRoundTrips = true
+  async function settled (clicking) {
+    const result = await clicking
+    if (!serverAnswersRoundTrips) return result
+    try {
+      await bot.tabComplete('/', false, false, ROUND_TRIP_TIMEOUT)
+    } catch (err) {
+      serverAnswersRoundTrips = false
+    }
+    return result
+  }
+
   async function craft (recipe, count, craftingTable) {
     assert.ok(recipe)
     count = parseInt(count ?? 1, 10)
+    serverAnswersRoundTrips = true
     if (recipe.requiresTable && !craftingTable) {
       throw new Error('Recipe requires craftingTable, but one was not supplied: ' + JSON.stringify(recipe))
     }
