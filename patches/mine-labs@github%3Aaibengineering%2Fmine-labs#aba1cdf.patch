+test("the Node session sends progress through child stdout to its process dispatcher", async () => {
+  const module = new URL("./node.ts", import.meta.url).href;
+  const source = `import { runNodeClient } from ${JSON.stringify(module)};
+    await runNodeClient(async session => {
+      session.ready();
+      await session.arranged; session.prepared(); await session.start;
+      session.progress("hit"); session.finish({ status: "succeeded" });
+      await new Promise(resolve => session.signal.addEventListener("abort", resolve, { once: true }));
+      session.progress("after-stop");
+    });`;
+  const scenario = scenarioSchema.parse({ client: { command: process.execPath, args: ["-e", source] }, players: [{ name: "Actor" }], goal: { kind: "completion" } });
+  const { client: command, ...definition } = scenario;
+  const reasons: string[] = [];
+  const completed = Promise.withResolvers<void>();
+  const client = launchScenarioClient({
+    client: command, scenario: definition, host: "127.0.0.1", port: 1, username: "Actor", version: "1.21.4", artifactsDirectory: "unused",
+    log: () => {}, onChat: () => {}, onProgress: reason => reasons.push(reason), onCompletion: () => completed.resolve(),
+  });
+  try {
+    await client.ready;
+    client.arranged();
+    await client.prepared;
+    client.start();
+    await completed.promise;
+  } finally { await client.stop("test complete"); }
+  assert.deepEqual(reasons, ["hit"]);
+});
