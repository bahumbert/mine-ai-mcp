+  /** `setblock ... air` commands, the head first so nothing fires while the chain is taken apart. */
+  remove: string[];
+  /** The blocks' chunk, which the runner pins for as long as they stand. */
+  region: SetupRegion;
+}
+
+/**
+ * A scenario's `tick` commands as command blocks instead of a datapack function.
+ *
+ * Installing a datapack means `reload`, which blocks the server thread for up
+ * to half a second and so freezes every other lane of a shared server. One
+ * repeating command block (always active) followed by chain command blocks
+ * (always active) runs the commands in the scenario's order, every tick, with
+ * no reload. The row starts at `control` and runs east, one block per command.
+ * `null` when there are no commands.
+ */
+export function tickBlockCommands(
+  commands: readonly string[],
+  control: { x: number; z: number },
+  dimension: Dimension,
+): TickBlocks | null {
+  if (commands.length === 0) return null;
+  const inArena = (command: string): string => inDimension(dimension, command);
+  const blocks = commands.map((command, index) => {
+    const kind = index === 0 ? "repeating_command_block" : "chain_command_block";
+    const position = `${control.x + index} ${TICK_BLOCK_Y} ${control.z}`;
+    const state = `minecraft:${kind}[facing=east]{Command:"${snbtString(inArena(command))}",auto:1b,TrackOutput:0b}`;
+    const install = inArena(`setblock ${position} ${state}`);
+    // The install runs through `executeChecked`, which wraps it in a prefix.
+    const bytes = Buffer.byteLength(CHECKED_COMMAND_PREFIX + install);
+    if (bytes > MAX_RCON_COMMAND_BYTES) {
+      throw new Error(
+        `tick command ${index + 1} needs a ${bytes}-byte setblock to install, above the ${MAX_RCON_COMMAND_BYTES} the server's RCON reads; shorten it, or run this scenario on a server of its own: ${command.slice(0, 60)}...`,
+      );
+    }
+    return { position, install };
+  });
+  const maxX = control.x + commands.length - 1;
+  return {
+    install: blocks.map((block) => block.install).reverse(),
+    remove: blocks.map((block) => inArena(`setblock ${block.position} minecraft:air`)),
+    region: {
+      dimension,
+      minX: control.x,
+      maxX,
+      minY: TICK_BLOCK_Y,
+      maxY: TICK_BLOCK_Y,
+      minZ: control.z,
+      maxZ: control.z,
+      chunks: chunkSpan(control.x, control.z, maxX, control.z),
+    },
+  };
+}
+
+/** The inside of an SNBT string literal: backslashes first, then quotes. */
+function snbtString(text: string): string {
+  return text.replaceAll("\\", "\\\\").replaceAll('"', '\\"');
+}
