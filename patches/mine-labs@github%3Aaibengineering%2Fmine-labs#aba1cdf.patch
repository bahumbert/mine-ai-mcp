+/** Consume client evidence at the current observed server tick, independently of log throttling. */
+function recordClientProgress(options: Parameters<typeof awaitScenarioGoal>[0], progress: GoalProgress, tick: number): void {
+  if (progress.reasons.size === 0) return;
+  progress.changedAt = tick;
+  for (const reason of progress.reasons) {
+    const loggedAt = progress.loggedReasons.get(reason);
+    if (loggedAt !== undefined && tick - loggedAt < 20) continue;
