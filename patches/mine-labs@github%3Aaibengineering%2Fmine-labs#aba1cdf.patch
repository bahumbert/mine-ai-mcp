@@ -0,0 +1,60 @@
+/**
+ * What a trial needs to know to share its server with other trials.
+ *
+ * A trial normally owns its server: it clears every entity, reloads a tick
+ * datapack and releases every chunk pin. A lane of a shared server must do none
+ * of that, because each of those reaches the neighbouring lanes. `arena` on the
+ * trial options switches all of them at once; this module holds the options and
+ * the choices that follow from them, so `run.ts` stays a runner.
+ */
+
+import { boxedClearEntities, CLEAR_ENTITIES, tickBlockCommands } from "../scenario/compile.js";
+import type { CompileOptions, EntityBox, TickBlocks } from "../scenario/compile.js";
+import type { Scenario } from "../scenario/schema.js";
+
+export interface ArenaTrialOptions {
+  /** The lane's name, e.g. "lane-3": only for logs and errors. */
+  id: string;
+  /** Entity clears of this trial stay inside the box. */
+  entityBox: EntityBox;
+  /** Block x,z of the lane's repeating command block; its chain runs east from it (y -63). */
+  controlChunk: { x: number; z: number };
+}
+
+/** The arena options of one running trial, with the command blocks its tick commands become. */
+export interface LaneContext {
+  arena: ArenaTrialOptions;
+  /** Null when the scenario has no tick commands. */
+  tickBlocks: TickBlocks | null;
+}
+
+/** Throws for trial options a lane cannot honour, before anything touches the world. */
+export function assertLaneTrial(opts: { arena?: ArenaTrialOptions; scenario: Scenario; reuseServer?: boolean; holdPreparedWorld?: boolean }): void {
+  const { arena } = opts;
+  if (!arena) return;
+  if (!opts.reuseServer) throw new Error(`${arena.id}: a lane shares its server, so the trial must set reuseServer`);
+  if (opts.holdPreparedWorld) throw new Error(`${arena.id}: spectator lanes are not supported (holdPreparedWorld freezes the whole server)`);
+  // The tick command blocks stand at y -63 of the overworld; the other dimensions start at y 0, and an entity box only reaches the overworld.
+  if (opts.scenario.world.dimension !== "overworld") {
+    throw new Error(`${arena.id}: a lane runs in the overworld, this scenario is in ${opts.scenario.world.dimension}; run it on a server of its own`);
+  }
+}
+
+/**
+ * The lane of a trial, or undefined for a trial that owns its server. Throws
+ * for a tick command the server's RCON cannot carry, still before the world is touched.
+ */
+export function laneContextOf(arena: ArenaTrialOptions | undefined, scenario: Scenario): LaneContext | undefined {
+  if (!arena) return undefined;
+  return { arena, tickBlocks: tickBlockCommands(scenario.tick, arena.controlChunk, scenario.world.dimension) };
+}
+
+/** What `compileScenario` is told for a lane; nothing for a trial that owns its server. */
+export function compileOptionsOf(lane: LaneContext | undefined): CompileOptions | undefined {
+  return lane ? { entityBox: lane.arena.entityBox, tickBlocks: true } : undefined;
+}
+
+/** The entity clear before a reused trial: boxed in a lane. */
+export function clearEntitiesOf(lane: LaneContext | undefined): string {
+  return lane ? boxedClearEntities(lane.arena.entityBox) : CLEAR_ENTITIES;
+}
